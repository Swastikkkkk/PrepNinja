# Backend Environment Variables

# Cloudinary Configuration (for video/audio storage)
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Gemini AI API Key (for AI interview question generation and analysis)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API Key (for speech-to-text transcription)
# Sign up at: https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Server Configuration
PORT=8080

# Code execution: Judge0 (preferred). Self-hosted CE: http://localhost:2358
# RapidAPI: https://judge0-ce.p.rapidapi.com plus JUDGE0_KEY. Unset = Piston fallback.
JUDGE0_URL=
JUDGE0_KEY=

# Skill Scoring Engine: tuned (default, benchmark-selected weights) | paper | bkt
SCORING_MODE=tuned

# Optional Cloud Firestore persistence (service-account JSON string or file path).
# Unset = local engine-data.json.
FIREBASE_SERVICE_ACCOUNT=

# Gemini model (default gemini-flash-latest)
GEMINI_MODEL=
